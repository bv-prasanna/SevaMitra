# Copy to .env for local development (see docker-compose.yml for local Postgres/Redis).
# Never commit a real .env file — see .gitignore.

NODE_ENV=development
PORT=3000

# --- Database (docs/ARCHITECTURE.md §7.1 — schema-per-domain, single DB) ---
DATABASE_URL="postgresql://sevamitra:sevamitra@localhost:5432/sevamitra?schema=auth"

# --- Auth / JWT ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"
# Deliberately a separate secret from JWT_ACCESS_SECRET so a password-reset
# token can never be replayed as a normal API access token.
JWT_RESET_SECRET="change-me-reset-secret"
JWT_RESET_TTL="10m"

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
# Local testing only: every OTP becomes this code. Ignored unless
# NOTIFICATION_PROVIDER="console". Never set it on a shared environment.
# OTP_FIXED_CODE=111111

# --- Social login (stubs for now — see src/auth/social) ---
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# --- Notification provider (Auth depends on this to actually deliver OTPs;
# stubbed with a console logger until the Notification module is built —
# see src/auth/otp/otp-sender.interface.ts) ---
NOTIFICATION_PROVIDER="console"

# --- IAM bootstrap (optional — see prisma/seed.ts). Set one of these to an
# existing user's phone/email before running `npm run db:seed` to grant that
# user the SUPER_ADMIN system role platform-wide, solving the chicken-and-egg
# problem of the very first admin having no permissions to grant themselves
# any via the API. ---
IAM_BOOTSTRAP_ADMIN_PHONE=""
IAM_BOOTSTRAP_ADMIN_EMAIL=""

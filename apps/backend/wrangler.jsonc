{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sevamitra-backend",
  "main": "infra/cloudflare/worker.ts",
  "compatibility_date": "2026-09-18",
  "containers": [
    {
      "class_name": "SevamitraContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SevamitraContainer",
        "name": "SEVAMITRA_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SevamitraContainer"]
    }
  ]
}
